# Optional local web-server port. The desktop app chooses a free loopback port.
PORT=4173

# Optional compatible NetEase API server. Leave blank to use the embedded provider.
NETEASE_API_BASE=

# Optional development-only login cookie. Treat any real value as a secret.
# The packaged desktop app encrypts its cookie and does not read it from this file.
NETEASE_COOKIE=
